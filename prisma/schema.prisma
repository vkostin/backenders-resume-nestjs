generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id          String       @id @default(uuid())
  name        String
  headline    String?
  description String
  photoKey    String?
  links       Link[]
  experiences Experience[]
  projects    Project[]
}

model Link {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  label     String
  url       String
  preferred Boolean @default(false)
  sortOrder Int

  @@index([profileId])
}

model SkillCategory {
  id        String               @id @default(uuid())
  name      String
  sortOrder Int
  skills    SkillCategorySkill[]

  @@unique([name])
}

model Skill {
  id          String               @id @default(uuid())
  name        String
  obsolete    Boolean              @default(false)
  sortOrder   Int
  categories  SkillCategorySkill[]
  experiences ExperienceSkill[]
  projects    ProjectSkill[]

  @@unique([name])
}

model SkillCategorySkill {
  categoryId String
  skillId    String
  sortOrder  Int
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  skill      Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([categoryId, skillId])
  @@index([skillId])
}

model Experience {
  id           String            @id @default(uuid())
  profileId    String
  profile      Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company      String?
  position     String
  description  String
  from         DateTime          @db.Date
  to           DateTime?         @db.Date
  sortOrder    Int
  skills       ExperienceSkill[]
  achievements Achievement[]
  projects     Project[]

  @@index([profileId])
}

model ExperienceSkill {
  experienceId String
  skillId      String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([experienceId, skillId])
  @@index([skillId])
}

model Achievement {
  id           String     @id @default(uuid())
  experienceId String
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  statement    String
  sortOrder    Int

  @@index([experienceId])
  @@index([projectId])
}

model Project {
  id            String         @id @default(uuid())
  profileId     String
  profile       Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  experienceId  String?
  experience    Experience?    @relation(fields: [experienceId], references: [id], onDelete: SetNull)
  name          String
  summary       String
  url           String?
  sortOrder     Int
  skills        ProjectSkill[]
  achievements  Achievement[]
  illustrations Illustration[]

  @@index([profileId])
  @@index([experienceId])
}

model ProjectSkill {
  projectId String
  skillId   String
  sortOrder Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
}

model Illustration {
  id        String  @id @default(uuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key       String
  alt       String
  sortOrder Int

  @@index([projectId])
}

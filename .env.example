# Postgres
DATABASE_URL=postgresql://portfolio:portfolio@localhost:5432/portfolio

# Silo (S3-compatible object storage)
S3_ENDPOINT=http://localhost:9000
# Public base URL of the bucket itself (bucket name is part of the path)
S3_PUBLIC_BASE_URL=http://localhost:9000/portfolio
S3_BUCKET=portfolio
S3_ACCESS_KEY=siloadmin
S3_SECRET_KEY=change-me
S3_REGION=us-east-1

# Seed
# full = upload media files from seed/media/ to Silo
# none = skip Silo entirely, no illustrations or photo
SEED_MEDIA=full
# 1 = force reseed from catalog (also empties the bucket in full mode)
SEED_RESET=
# Directory with media files (default: ./seed/media)
SEED_MEDIA_DIR=

# Mutations: sent in the X-Admin-Token header
ADMIN_TOKEN=dev-admin-token

PORT=3000
